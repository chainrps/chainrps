# ==================== 服务配置 ====================
HOST=0.0.0.0
PORT=8000

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379/0

# ==================== SQLite 配置 ====================
DATABASE_PATH=./data/rps.db

# ==================== 合约配置 ====================
CONTRACT_ADDRESS=
# 本地测试网配置 (Ganache)
RPC_URL=http://127.0.0.1:8686
RPC_CHAIN_ID=5208888
# Polygon Amoy 测试网配置
# RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# CHAIN_ID=80002

# ==================== Relayer 配置（方案A/B 代提交） ====================
# Relayer 签名私钥：用于调用合约 submitCommitWithSig/revealChoiceWithSig 代玩家上链
# 安全要求（S1-02）：
#   - 必须通过环境变量加载，绝不硬编码到代码或写入数据库
#   - 绝不打印到日志、绝不通过 API 返回给前端
#   - 生产环境建议存放在密钥管理服务（如 KMS / Vault），仅在启动时注入
#   - 该账户需保有足够原生代币以支付 gas 费，否则会触发前端降级到玩家自付 gas 模式
RELAYER_PRIVATE_KEY=
# Relayer 钱包地址：从私钥派生，启动时会与私钥派生地址校验一致性
# 若不一致将以私钥派生地址为准，并打印警告
# 用于前端调用合约 authorizeRelayer(relayerAddress, 0) 时获取正确的 relayer 地址
RELAYER_ADDRESS=

# ==================== 超时配置（秒） ====================
COMMIT_TIMEOUT=66
REVEAL_TIMEOUT=88

# ==================== WebSocket 配置 ====================
WS_HEARTBEAT_INTERVAL=30

# ==================== 管理员配置 ====================
# 管理员白名单（逗号分隔钱包地址，为空则不启用权限校验）
ADMIN_WHITELIST=

# ==================== Redis Key 前缀 ====================
MATCH_QUEUE_PREFIX=rps:match:
GAME_CACHE_PREFIX=rps:game:
WS_PREFIX=rps:ws: