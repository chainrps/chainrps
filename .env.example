# ========================================
# ChainRPS 环境变量示例文件
# ========================================
# 
# 用法：复制此文件为 .env，然后根据需要修改配置
#   cp .env.example .env
#
# 说明：
# - 此文件展示所有可配置的环境变量
# - 非敏感配置的默认值见 rps_backend/config/defaults.py
# - .env 文件不应提交到版本控制
# ========================================


# ==================== 敏感配置（必须设置）====================

# 部署者私钥（部署脚本使用，必填）
# 获取方式：从 Ganache/Hardhat 本地链账户中获取
DEPLOYER_PRIVATE_KEY=

# Relayer 私钥（代玩家上链使用，可选）
# 获取方式：从管理员账户中获取
RELAYER_PRIVATE_KEY=

# JWT 密钥（生产环境必须设置高强度随机字符串）
# 建议使用 openssl rand -hex 32 生成
JWT_SECRET=chainrps-dev-secret-change-in-production-please

# 管理员钱包地址白名单（逗号分隔）
# 生产环境必须配置，开发环境可留空配合 DEBUG=true
# 示例：ADMIN_WHITELIST=0xAddress1,0xAddress2
ADMIN_WHITELIST=

# 默认管理员密码（首次启动时使用，建议首次登录后修改）
DEFAULT_ADMIN_PASSWORD=ADMIN


# ==================== 服务器配置 ====================
# HOST=0.0.0.0
# PORT=8000


# ==================== Redis 配置 ====================
# REDIS_URL=redis://localhost:6379/0


# ==================== 数据库配置 ====================
# DATABASE_PATH=./data/rps.db


# ==================== 合约配置 ====================
# 部署后通过管理后台更新：http://127.0.0.1:8000/admin#/contracts
# CONTRACT_ADDRESS=0x5b1869D9A4C187F2EAa108f3062412ecf0526b24


# ==================== RPC 配置 ====================
# 本地链 (Ganache/Hardhat)
# RPC_LOCAL_NETWORK=ChainRPS_Local
# RPC_LOCAL_HOST=127.0.0.1
# RPC_LOCAL_PORT=8686
# RPC_LOCAL_SYMBOL=POL
# RPC_LOCAL_ACCOUNT_COUNT=10
# RPC_LOCAL_BALANCE=100000

# ChainRPS 配置链
# RPC_NETWORK=ChainRPS_Local
# RPC_URL=http://127.0.0.1:8686
# RPC_CHAIN_ID=5208888
# RPC_SYMBOL=POL


# ==================== 超时配置（秒）====================
# COMMIT_TIMEOUT=66
# REVEAL_TIMEOUT=88


# ==================== WebSocket 配置 ====================
# WS_HEARTBEAT_INTERVAL=30


# ==================== 开发模式 ====================
# DEBUG=true


# ==================== Redis Key 前缀配置 ====================
# MATCH_QUEUE_PREFIX=rps:match:
# GAME_CACHE_PREFIX=rps:game:
# ROOM_CACHE_PREFIX=rps:room:
# WS_PREFIX=rps:ws:
# REDIS_BROADCAST_CHANNEL=rps:broadcast
# REDIS_DIRECT_CHANNEL=rps:direct


# ==================== Bot 配置 ====================
# BOT_ENABLED=true
# BOT_WALLET_INDEX=9
# BOT_TOKEN=USDC
# BOT_BET_AMOUNT=10.0
# BOT_AUTO_CREATE_ROOM=true
# BOT_AUTO_JOIN_ROOM=true
# BOT_CREATE_INTERVAL=60
# BOT_SCAN_INTERVAL=10
# BOT_COMMIT_DELAY=3
# BOT_REVEAL_DELAY=2
# BOT_MAX_CONCURRENT_ROOMS=3
# BOT_LABEL=🤖 AI陪玩
# BOT_WALLET_BALANCE_THRESHOLD=1.0

# Bot 钱包池
# BOT_WALLET_POOL_START=1
# BOT_WALLET_POOL_END=9
# BOT_WALLET_INITIAL_ETH=1000.0
# BOT_WALLET_INITIAL_USDC=1000000.0

# Bot 默认策略
# BOT_DEFAULT_STRATEGY=random
# BOT_AUTO_CHAIN_MATCH=true


# ==================== 部署配置 ====================
# FEE_COLLECTOR=
# OFFICIAL_DEVELOPER=
# CONTRACT_NAME=ChainRPS
# CONTRACT_VERSION=v1.0.0
# NETWORK=amoy
