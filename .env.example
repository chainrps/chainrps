# ==================== 服务配置 ====================
HOST=0.0.0.0
PORT=8000

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379/0

# ==================== SQLite 配置 ====================
DATABASE_PATH=./data/rps.db

# ==================== 合约配置 ====================
CONTRACT_ADDRESS=
# 本地测试网配置 (Ganache)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Polygon Amoy 测试网配置
# RPC_URL=https://rpc-amoy.polygon.technology/
# CHAIN_ID=80002

# ==================== 超时配置（秒） ====================
COMMIT_TIMEOUT=66
REVEAL_TIMEOUT=88

# ==================== WebSocket 配置 ====================
WS_HEARTBEAT_INTERVAL=30

# ==================== 管理员配置 ====================
# 管理员白名单（逗号分隔钱包地址，为空则不启用权限校验）
ADMIN_WHITELIST=

# ==================== Redis Key 前缀 ====================
MATCH_QUEUE_PREFIX=rps:match:
GAME_CACHE_PREFIX=rps:game:
WS_PREFIX=rps:ws:
